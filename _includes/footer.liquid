{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}.
  {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.newsletter.enabled %}
  {% include newsletter.liquid %}
{% endif %}

{% if site.enable_navbar_social %}
  <div class="footer-social-wrapper">
    <div class="container">
      <div class="footer-social">
        {% social_links %}
      </div>
      <div class="footer-contact-note">
        Email is the best way to reach me.
      </div>
    </div>
  </div>
{% endif %}

<footer class="sticky-bottom mt-5" role="contentinfo">
  <div class="container">
    {{ footer_contents }}
  </div>
</footer>