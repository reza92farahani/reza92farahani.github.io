{% comment %} <div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div> {% endcomment %}


{% assign news_items = site.news | sort: "date" | reverse %}

{% assign news_limit = page.announcements.limit | default: 10 %}
{% if news_limit %}
  {% assign news_items = news_items | slice: 0, news_limit %}
{% endif %}

{% assign scrollable_news = page.announcements.scrollable | default: false %}

<div class="news">
  {% if scrollable_news %}
    <div style="max-height: 420px; overflow-y: auto; padding-right: 0.5rem;">
  {% endif %}

  <table class="table table-sm table-borderless">
    {% for item in news_items %}
      <tr>
        <th scope="row" style="width: 140px;">{{ item.date | date: "%b %d, %Y" }}</th>
        <td>
          {% if item.inline %}
            {{ item.content }}
          {% else %}
            <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </table>

  {% if scrollable_news %}
    </div>
  {% endif %}
</div>